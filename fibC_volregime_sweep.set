VolRegimeMult,1=2.5
VolRegimeMult,2=0.5
VolRegimeMult,3=4.0

VolFloorMaxMult=2.0
VolFloorMaxMult,F=0

VolATRFastPeriod=5
VolATRFastPeriod,F=0
VolATRSlowPeriod=60
VolATRSlowPeriod,F=0

